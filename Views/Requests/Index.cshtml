@model IEnumerable<TestNalog.Models.Request>

@{
    ViewData["Title"] = "Заявки";
}
<h1>Заявки</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        Создать заявку
    </a>
</p>

@if (!Model.Any())
{
    <p>Заявок пока нет.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Название</th>
                <th>Сотрудник</th>
                <th>Дата создания</th>
                <th>Статус</th>
                <th>Приоритет</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var request in Model)
            {
                <tr>
                    <td>@request.Title</td>
                    <td>@request.Employee?.FullName</td>
                    <td>@request.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@request.Status</td>
                    <td>@request.Priority</td>
                </tr>
            }
        </tbody>
    </table>
}