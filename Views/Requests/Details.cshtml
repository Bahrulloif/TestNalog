@model TestNalog.Models.Request

<h1>Детали заявки</h1>

<div>
    <p>Название: @Model.Title</p>
    <p>@Model.Description</p>
    <p>Сотрудник: @Model.Employee</p>
    <p>Дата создания: @Model.CreatedDate</p>
    <p>Приоритет: @Model.Priority</p>
    <p>Статус: @Model.Status</p>
</div>

<a asp-action="Index">Назад к списку сотрудников</a>
<a asp-action="Edit" asp-route-id="@Model.Id">Редактировать</a>